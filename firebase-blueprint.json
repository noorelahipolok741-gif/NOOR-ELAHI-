{
  "entities": {
    "SubjectDoc": {
      "title": "Subject",
      "description": "Course subject containing sections and class video/PDF slots managed by admin.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 2000 },
        "isPublished": { "type": "boolean" },
        "sections": { "type": "array" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "description", "isPublished", "sections", "updatedBy", "updatedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account profile containing name, email/phone, avatar, and role.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "email": { "type": "string", "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 30 },
        "photoUrl": { "type": "string", "maxLength": 65000 },
        "passwordHash": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["student", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "email", "phone", "photoUrl", "passwordHash", "role", "createdAt", "updatedAt"]
    },
    "WatchProgress": {
      "title": "WatchProgress",
      "description": "Per-user video playback resume timestamp and duration.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "itemId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "subjectId": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sectionId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "currentTime": { "type": "number" },
        "duration": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "itemId", "subjectId", "sectionId", "currentTime", "duration", "updatedAt"]
    },
    "DownloadRecord": {
      "title": "DownloadRecord",
      "description": "Cloud-synced record of downloaded video and PDF class items per user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "itemId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "subjectId": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sectionId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sectionTitle": { "type": "string", "minLength": 1, "maxLength": 160 },
        "classNumber": { "type": "number" },
        "videoName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "videoUrl": { "type": "string", "maxLength": 1000 },
        "pdfUrl": { "type": "string", "maxLength": 1000 },
        "fileSizeBytes": { "type": "number" },
        "downloadedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "itemId", "subjectId", "sectionId", "sectionTitle", "classNumber", "videoName", "videoUrl", "pdfUrl", "fileSizeBytes", "downloadedAt"]
    },
    "AppNotification": {
      "title": "AppNotification",
      "description": "Announcement sent when admin adds new videos or PDFs to a subject section.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "subjectId": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "subjectName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "sectionTitle": { "type": "string", "minLength": 1, "maxLength": 160 },
        "itemName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 },
        "isActive": { "type": "boolean" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "subjectId", "subjectName", "sectionTitle", "itemName", "message", "isActive", "createdBy", "createdAt"]
    },
    "InboxMessage": {
      "title": "InboxMessage",
      "description": "Password change notifications and user issue reports sent to admin inbox.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "enum": ["password_change", "issue_report"] },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "senderEmail": { "type": "string", "maxLength": 160 },
        "senderPhone": { "type": "string", "maxLength": 30 },
        "newPassword": { "type": "string", "maxLength": 128 },
        "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "uid", "type", "senderName", "senderEmail", "senderPhone", "newPassword", "message", "createdAt"]
    },
    "AdminConfig": {
      "title": "AdminConfig",
      "description": "Admin-only File Vault security configuration.",
      "type": "object",
      "properties": {
        "vaultPasswordHash": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["vaultPasswordHash", "updatedBy", "updatedAt"]
    }
  },
  "firestore": {
    "/subjects/{subjectId}": {
      "schema": { "$ref": "#/entities/SubjectDoc" },
      "description": "7 core subjects with sections and class video/PDF links."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profiles isolated to owner and admin."
    },
    "/users/{userId}/progress/{itemId}": {
      "schema": { "$ref": "#/entities/WatchProgress" },
      "description": "Per-user video playback resume timestamps."
    },
    "/users/{userId}/downloads/{itemId}": {
      "schema": { "$ref": "#/entities/DownloadRecord" },
      "description": "Per-user downloaded video and PDF registry."
    },
    "/notifications/{notifId}": {
      "schema": { "$ref": "#/entities/AppNotification" },
      "description": "Course content update notifications."
    },
    "/adminInbox/{messageId}": {
      "schema": { "$ref": "#/entities/InboxMessage" },
      "description": "Admin inbox for user password recovery alerts and issue reports."
    },
    "/adminConfig/{configId}": {
      "schema": { "$ref": "#/entities/AdminConfig" },
      "description": "File Vault passcode hash accessible only to admin."
    }
  }
}
